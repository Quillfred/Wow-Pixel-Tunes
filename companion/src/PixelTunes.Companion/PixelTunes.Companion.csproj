<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>PixelTunes</AssemblyName>
    <RootNamespace>PixelTunes.Companion</RootNamespace>
    <Version>0.4.4</Version>
    <Product>PixelTunes Companion</Product>
    <ApplicationIcon>PixelTunes.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <Using Include="System.Drawing" />
    <Using Include="System.Windows.Forms" />
    <ProjectReference Include="..\PixelTunes.Core\PixelTunes.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="PixelTunes.ico" />
  </ItemGroup>
</Project>
